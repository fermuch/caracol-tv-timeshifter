{
  "cosmos-installer": {},
  "minVersion": "0.9.0",
  "services": {
    "{ServiceName}": {
      "container_name": "{ServiceName}",
      "hostname": "{ServiceName}",
      "image": "ghcr.io/fermuch/caracol-tv-timeshifter:hls",
      "restart": "unless-stopped",
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "volumes": [
        {
          "type": "volume",
          "source": "{ServiceName}-data",
          "target": "/usr/share/nginx/html",
          "readOnly": true
        }
      ],
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Caracol TV timeshift HLS",
          "mode": "SERVAPP",
          "target": "http://{ServiceName}:80",
          "useHost": true,
          "Host": "{ServiceName}.{RootHostname}",
          "AuthEnabled": false,
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    },
    "{ServiceName}-recorder": {
      "container_name": "{ServiceName}-recorder",
      "hostname": "{ServiceName}-recorder",
      "image": "ghcr.io/fermuch/caracol-tv-timeshifter:latest",
      "restart": "unless-stopped",
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-stack": "{ServiceName}"
      },
      "environment": [
        "SOURCE=http://138.121.15.230:9002/CARACOL/tracks-v1a1/mono.m3u8",
        "OUT=/data",
        "WINDOW=60",
        "CONNS=24",
        "POLL=1.5"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "{ServiceName}-data",
          "target": "/data"
        }
      ]
    }
  }
}
