{
  "services": {
    "timeshift-recorder": {
      "container_name": "timeshift-recorder",
      "image": "ghcr.io/fermuch/caracol-tv-timeshifter:latest",
      "restart": "unless-stopped",
      "labels": {
        "cosmos-auto-update": "true"
      },
      "environment": [
        "SOURCE=http://138.121.15.230:9002/CARACOL/tracks-v1a1/mono.m3u8",
        "OUT=/data",
        "WINDOW=60",
        "CONNS=24",
        "POLL=1.5"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "timeshift-data",
          "target": "/data"
        }
      ]
    },
    "timeshift-hls": {
      "container_name": "timeshift-hls",
      "image": "ghcr.io/fermuch/caracol-tv-timeshifter:hls",
      "restart": "unless-stopped",
      "labels": {
        "cosmos-auto-update": "true"
      },
      "volumes": [
        {
          "type": "volume",
          "source": "timeshift-data",
          "target": "/usr/share/nginx/html",
          "readOnly": true
        }
      ],
      "routes": [
        {
          "Name": "timeshift",
          "Description": "Caracol TV timeshift HLS",
          "Mode": "SERVAPP",
          "Target": "http://timeshift-hls:80",
          "UseHost": true,
          "Host": "timeshift.example.com",
          "AuthEnabled": false,
          "SmartShield": {
            "Enabled": false
          }
        }
      ]
    }
  }
}
